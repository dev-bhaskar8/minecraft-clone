{
  "name": "clawcraft",
  "version": "1.0.0",
  "description": "Clawcraft is a browser-based Minecraft clone built with Three.js, featuring procedural terrain generation, block placement/destruction, and first-person controls.",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:base": "hardhat run scripts/deploy-worldboard.js --network base",
    "deploy:baseSepolia": "hardhat run scripts/deploy-worldboard.js --network baseSepolia",
    "upgrade:base": "hardhat run scripts/upgrade-worldboard.js --network base",
    "upgrade:baseSepolia": "hardhat run scripts/upgrade-worldboard.js --network baseSepolia",
    "test": "hardhat test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-bhaskar8/minecraft-clone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dev-bhaskar8/minecraft-clone/issues"
  },
  "homepage": "https://github.com/dev-bhaskar8/minecraft-clone#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "chai": "^6.2.2",
    "hardhat": "^2.28.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "dotenv": "^17.2.4",
    "ethers": "^6.16.0"
  }
}
