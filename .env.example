# Hardhat deploy/upgrade config
# Copy to .env and fill values.

# Deployer private key (no 0x prefix).
PRIVATE_KEY=

# RPC URLs
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Deployed CRAFT token address (Base)
CRAFT_TOKEN=0x72067c2c0fe154f4edac04946631377d12a11b07

# Board params
SLOT_COUNT=10
# Claim price in token smallest units (wei for 18 decimals). Example: 100 * 1e18
CLAIM_PRICE_WEI=

# For upgrades
WORLDBOARD_PROXY=
